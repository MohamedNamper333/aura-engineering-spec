{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aura.example/schemas/events/event-coverage-manifest.json",
  "title":"AURA Event Contract Coverage Manifest",
  "type":"object","additionalProperties":false,
  "required":["version","source_contract","registry","events"],
  "properties":{
    "version":{"const":1},
    "source_contract":{"const":"EVENT_CONTRACTS.md"},
    "registry":{"const":"schemas/events/event-registry.json"},
    "events":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["event_type","version"],
        "properties":{
          "event_type":{"type":"string","minLength":1},
          "version":{"type":"integer","minimum":1}
        }
      }
    }
  }
}
