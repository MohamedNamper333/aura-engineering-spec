{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aura.example/schemas/api/api-coverage-manifest.json",
  "title":"AURA API Contract Coverage Manifest",
  "type":"object","additionalProperties":false,
  "required":["version","source_contract","openapi","operations"],
  "properties":{
    "version":{"const":1},"source_contract":{"const":"API_CONTRACTS.md"},"openapi":{"const":"schemas/api/openapi.yaml"},
    "operations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["method","path","operation_id","status"],"properties":{"method":{"type":"string","enum":["GET","POST","PUT","PATCH","DELETE"]},"path":{"type":"string","pattern":"^/api/v1/"},"operation_id":{"type":"string","minLength":1},"status":{"type":"string","enum":["implemented","planned","deprecated"]}}}}
  },
  "operations":[
    {"method":"POST","path":"/api/v1/auth/register","operation_id":"registerUser","status":"implemented"},
    {"method":"POST","path":"/api/v1/auth/login","operation_id":"loginUser","status":"implemented"},
    {"method":"POST","path":"/api/v1/auth/logout","operation_id":"logoutUser","status":"implemented"},
    {"method":"POST","path":"/api/v1/auth/recovery/request","operation_id":"requestAccountRecovery","status":"implemented"},
    {"method":"POST","path":"/api/v1/auth/recovery/confirm","operation_id":"confirmAccountRecovery","status":"implemented"},
    {"method":"GET","path":"/api/v1/me","operation_id":"getCurrentUser","status":"implemented"},
    {"method":"GET","path":"/api/v1/sections","operation_id":"listSections","status":"implemented"},
    {"method":"GET","path":"/api/v1/subjects/{subject_id}","operation_id":"getSubject","status":"implemented"},
    {"method":"GET","path":"/api/v1/courses/{course_id}","operation_id":"getCourse","status":"implemented"},
    {"method":"GET","path":"/api/v1/courses/{course_id}/lectures","operation_id":"listCourseLectures","status":"implemented"},
    {"method":"GET","path":"/api/v1/lectures/{lecture_id}","operation_id":"getLecture","status":"implemented"},
    {"method":"POST","path":"/api/v1/lectures/{lecture_id}/progress","operation_id":"updateLectureProgress","status":"implemented"},
    {"method":"POST","path":"/api/v1/quizzes/{quiz_id}/attempts","operation_id":"submitQuizAttempt","status":"implemented"},
    {"method":"GET","path":"/api/v1/me/learning/progress","operation_id":"getMyLearningProgress","status":"implemented"},
    {"method":"POST","path":"/api/v1/orders","operation_id":"createOrder","status":"implemented"},
    {"method":"GET","path":"/api/v1/orders/{order_id}","operation_id":"getOrder","status":"implemented"},
    {"method":"POST","path":"/api/v1/orders/{order_id}/cancel","operation_id":"cancelOrder","status":"implemented"},
    {"method":"POST","path":"/api/v1/payments","operation_id":"createPayment","status":"implemented"},
    {"method":"GET","path":"/api/v1/payments/{payment_id}","operation_id":"getPayment","status":"implemented"},
    {"method":"POST","path":"/api/v1/refunds","operation_id":"createRefund","status":"implemented"},
    {"method":"GET","path":"/api/v1/me/entitlements","operation_id":"listMyEntitlements","status":"implemented"},
    {"method":"GET","path":"/api/v1/content/{content_id}/access","operation_id":"getContentAccess","status":"implemented"},
    {"method":"POST","path":"/api/v1/activation-codes/redeem","operation_id":"redeemActivationCode","status":"implemented"},
    {"method":"GET","path":"/api/v1/me/activation-redemptions","operation_id":"listMyActivationRedemptions","status":"implemented"},
    {"method":"POST","path":"/api/v1/webhooks/{provider}","operation_id":"receiveProviderWebhook","status":"implemented"}
  ]
}
